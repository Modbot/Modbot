<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The shared-texture handover is checked by opening the texture on a second device and
         reading the pixels back, which needs pointer arithmetic over the mapped rows. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Linked rather than copied. The whole point of the end-to-end test is that the overlay is
         driven by the log VRChat actually wrote, and a second copy of a fixture is a second copy
         that can quietly drift from the first. -->
    <Content Include="..\Modbot.Companion.Tests\Fixtures\behaviour-2026-09-03.txt"
             Link="Fixtures\behaviour-2026-09-03.txt"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modbot.Overlay\Modbot.Overlay.csproj" />
    <ProjectReference Include="..\Modbot.TestSupport\Modbot.TestSupport.csproj" />
  </ItemGroup>

</Project>
