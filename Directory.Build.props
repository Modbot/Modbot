<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Invariant mode throws for any named culture unless this is off. Discord.Net builds one from
         the server's preferred language as the server arrives, and the throw stopped the bot
         loading the server at all. With this off a named culture is created, carrying invariant
         data, and nothing needs ICU. -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The web SDK turns Server GC on by default, and every server here inherited it without
         anybody choosing it. Server GC keeps a heap per core and lets each one grow before
         collecting, which is the right trade for a machine whose job is throughput. Modbot's
         servers spend their lives waiting: on timers, on Discord's socket, and on VRChat at 1.45
         requests a second. Measured on Modbot.Server, idle, same binary, only this flag differing:
         215 MB private and 62 threads with it on, 70 MB and 27 threads with it off.

         Background GC stays on. Turning it off as well was measured too and cost 37 MB rather than
         saving any, because gen2 collections become blocking and the heap grows further between
         them. GCConserveMemory made no difference worth the CPU.

         An operator running one Modbot on a large machine can still put it back with the
         DOTNET_gcServer environment variable; this is the default, not a ceiling. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!-- A release build names its version once, as ModbotRelease (YYYY.M.PATCH), and every
       assembly is stamped from it: the four-part AssemblyVersion is the direct mapping from
       foundation 2.7.2, and the display version is the calendar string itself. Nothing is set
       when ModbotRelease is absent, so an ordinary development build is unchanged.

       A client build handed to testers before the release says so: 2026.9.2-preview.1. Only the
       display versions can carry that, because AssemblyVersion and FileVersion are four whole
       numbers and nothing else, so those two get the numbers alone. A preview and the release it
       leads to therefore share a FileVersion; InformationalVersion, which is what
       ModbotVersion.Release and every screen show, is where they differ. -->
  <PropertyGroup Condition="'$(ModbotRelease)' != ''">
    <ModbotReleaseNumbers>$([System.Text.RegularExpressions.Regex]::Replace('$(ModbotRelease)', '-.*$', ''))</ModbotReleaseNumbers>
    <Version>$(ModbotRelease)</Version>
    <AssemblyVersion>$(ModbotReleaseNumbers).0</AssemblyVersion>
    <FileVersion>$(ModbotReleaseNumbers).0</FileVersion>
    <InformationalVersion>$(ModbotRelease)</InformationalVersion>
  </PropertyGroup>
</Project>
