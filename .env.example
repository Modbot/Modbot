# Copy to .env next to docker-compose.yml and fill in the passwords. .env is ignored by git.

# Required
POSTGRES_PASSWORD=
SEQ_ADMIN_PASSWORD=

# Optional
POSTGRES_DB=modbot
POSTGRES_USER=modbot
MODBOT_PORT=8080
# Which address Modbot's port opens on. Empty is this machine only; 0.0.0.0 opens it to others.
MODBOT_BIND=
# The code the setup wizard asks for until the first account exists. Empty prints a new one at
# each start: docker compose logs modbot | grep "Setup code"
MODBOT_SETUP_CODE=
SEQ_PORT=5380
MODBOT_DEBUG_LOGGING=
# serilog (readable lines, the default), json or railway_json. Changes the console only.
CONSOLE_LOG_MODE=
# Verbose, Debug, Information (the default), Warning, Error or Fatal.
LOG_LEVEL=
# This server's own Modbot Cloud address, and 1 to stop it talking to Cloud: no report every six
# hours, no term list downloads, no registration, no rooms listed on modbot.co and no log sent for
# support. Companions are not affected.
MODBOT_CLOUD_ENDPOINT=
MODBOT_CLOUD_DISABLED=
# Where the server selector is, for the "Add to my.modbot.co" links. Modbot never calls it.
MODBOT_MY_URL=
# 1 runs this Modbot as a public demo: made-up data, no sign-in, every visitor an administrator.
# Only on a database that was never set up. Hours between automatic resets, 0 for never.
MODBOT_DEMO=
MODBOT_DEMO_RESET_HOURS=
MODBOT_COMMIT=
MODBOT_BRANCH=
