# Copy to .env next to docker-compose.yml and fill in the passwords. .env is ignored by git.

# Required
POSTGRES_PASSWORD=
SEQ_ADMIN_PASSWORD=

# Optional
POSTGRES_DB=modbot
POSTGRES_USER=modbot
MODBOT_PORT=8080
SEQ_PORT=5380
MODBOT_DEBUG_LOGGING=
# serilog (readable lines, the default), json or railway_json. Changes the console only.
CONSOLE_LOG_MODE=
# Verbose, Debug, Information (the default), Warning, Error or Fatal.
LOG_LEVEL=
# This server's own Modbot Cloud address, and 1 to stop it talking to Cloud. Desktop clients are not affected.
# Cloud is used for two things: listing the group's rooms that anyone can join on modbot.co, and
# sending this server's own log for support. Both are on by default and turned off in Settings.
MODBOT_CLOUD_ENDPOINT=
MODBOT_CLOUD_DISABLED=
# 1 runs this Modbot as a public demo: made-up data, no sign-in, every visitor an administrator.
# Only on a database that was never set up. Hours between automatic resets, 0 for never.
MODBOT_DEMO=
MODBOT_DEMO_RESET_HOURS=
MODBOT_COMMIT=
MODBOT_BRANCH=
