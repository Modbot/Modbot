# Copy to .env next to docker-compose.yml and fill in the passwords. .env is ignored by git.

# Required
POSTGRES_PASSWORD=
SEQ_ADMIN_PASSWORD=

# Optional
POSTGRES_DB=modbot
POSTGRES_USER=modbot
MODBOT_PORT=8080
SEQ_PORT=5380
MODBOT_DEBUG_LOGGING=
# This server's own Modbot Cloud address, and 1 to stop it talking to Cloud. Desktop clients are not affected.
MODBOT_CLOUD_ENDPOINT=
MODBOT_CLOUD_DISABLED=
MODBOT_COMMIT=
MODBOT_BRANCH=
