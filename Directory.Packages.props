<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- The overlay and the client window share one UI stack (M3 6.0.1). Avalonia renders through
         SkiaSharp, so the same code draws a desktop window and the offscreen frame handed to
         SteamVR; WPF and MAUI have no supported path from rendered UI to a GPU texture. -->
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.22" />
    <!-- An embedded face, so the overlay never depends on what fonts the machine has and never
         fetches one over the network. -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- Direct3D 11 interop for the shared texture SteamVR's compositor opens. -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- The desktop client's installer and updater (M3 spec, "Installing and updating"). Per-user,
         no administrator rights, delta updates, and the maintained successor to Squirrel. Its
         version is pinned alongside the vpk tool the release workflow installs. -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Writes the OpenAPI document to docs/openapi/modbot.json on every build of Modbot.Host, so
         the documentation site's API reference is made from the endpoints themselves. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <!-- Npgsql 10.0.3 asks for EF Core 10.0.4 while the Design package asks for 10.0.12; pinned
         centrally so every project compiles and runs against one EF Core. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <!-- DPAPI, for the Windows client's device tokens. Windows-only by nature; the client is a
         Windows-only product by design (M3 10), so this is not a portability compromise. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.16" />
    <!-- The gateway half of Discord.Net only: slash commands, embeds and one channel to post to
         need the socket client and the REST client it carries, not the text-command or
         interaction frameworks the metapackage adds. -->
    <PackageVersion Include="Discord.Net.WebSocket" Version="3.20.1" />
    <!-- The official OpenAI SDK, used against any OpenAI-compatible endpoint: OpenAI itself,
         OpenRouter, xAI, Anthropic's compatibility layer, or a local server such as Ollama
         (M8 4.2). One client library rather than one per provider. -->
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <!-- Time zones for AI insight schedules, from its own copy of the IANA time zone database:
         with InvariantGlobalization, TimeZoneInfo cannot read IANA names on Windows, and this
         does not depend on the container having time zone files either. -->
    <PackageVersion Include="NodaTime" Version="3.3.4" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="VRChat.API" Version="2.20.9" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
  </ItemGroup>
  <!-- Test-only packages. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>