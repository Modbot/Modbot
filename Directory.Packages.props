<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- The overlay and the client window share one UI stack (M3 6.0.1). Avalonia renders through
         SkiaSharp, so the same code draws a desktop window and the offscreen frame handed to
         SteamVR; WPF and MAUI have no supported path from rendered UI to a GPU texture. -->
    <PackageVersion Include="Avalonia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Headless" Version="11.3.22" />
    <!-- An embedded face, so the overlay never depends on what fonts the machine has and never
         fetches one over the network. -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <!-- Direct3D 11 interop for the shared texture SteamVR's compositor opens, and — from the same
         3.8.3 line, so one set of native bindings serves both — the desktop duplication and Media
         Foundation the clips recorder uses (clips design spec §3). Both are MIT and ship nothing
         native: Direct3D, DXGI and Media Foundation all come from Windows itself. -->
    <PackageVersion Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageVersion Include="Vortice.MediaFoundation" Version="3.8.3" />
    <!-- The overlay on WiVRn and Monado (overlay-on-OpenXR spec, 3.2): an OpenXR session with
         XR_EXTX_overlay, drawn through Vulkan. Both bindings are MIT and ship nothing native; the
         loader and Vulkan come from the machine. -->
    <PackageVersion Include="Silk.NET.OpenXR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Vulkan" Version="2.23.0" />
    <!-- The companion's installer and updater (M3 spec, "Installing and updating"). Per-user,
         no administrator rights, delta updates, and the maintained successor to Squirrel. Its
         version is pinned alongside the vpk tool the release workflow installs. -->
    <PackageVersion Include="Velopack" Version="1.2.0" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Writes the OpenAPI document to docs/openapi/modbot.json on every build of Modbot.Server, so
         the documentation site's API reference is made from the endpoints themselves. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />
    <!-- Npgsql 10.0.3 asks for EF Core 10.0.4 while the Design package asks for 10.0.12; pinned
         centrally so every project compiles and runs against one EF Core. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.3" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <!-- DPAPI, for the Windows client's device tokens. Windows-only by nature; the client is a
         Windows-only product by design (M3 10), so this is not a portability compromise. -->
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageVersion Include="Serilog.Expressions" Version="5.0.0" />
    <!-- One log line per HTTP request, replacing the four ASP.NET Core writes by itself. Referenced
         by the web projects only: it carries a reference to the whole ASP.NET Core framework, so it
         must never reach Modbot.Shared, which the companion is built on. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.16" />
    <!-- The gateway half of Discord.Net only: slash commands, embeds and one channel to post to
         need the socket client and the REST client it carries, not the text-command or
         interaction frameworks the metapackage adds. -->
    <PackageVersion Include="Discord.Net.WebSocket" Version="3.20.1" />
    <!-- The official OpenAI SDK, used against any OpenAI-compatible endpoint: OpenAI itself,
         OpenRouter, xAI, Anthropic's compatibility layer, or a local server such as Ollama
         (M8 4.2). One client library rather than one per provider. -->
    <PackageVersion Include="OpenAI" Version="2.13.0" />
    <!-- Time zones for AI insight schedules, from its own copy of the IANA time zone database:
         with InvariantGlobalization, TimeZoneInfo cannot read IANA names on Windows, and this
         does not depend on the container having time zone files either. -->
    <PackageVersion Include="NodaTime" Version="3.3.4" />
    <!-- Works out what language a piece of text is in, offline, from language profiles built into
         the assembly: no data file to ship and no request to anybody. Used to mark the language on
         every moderation flag (M8 4.4). Apache-2.0, a .NET Standard port of Nakatani Shuyo's
         language-detection, targeting net8.0 with no dependencies of its own. The alternatives
         were a .NET Framework 4.5 assembly that will not load on .NET 10, one that needs a 2.4 MB
         corpus file committed for fourteen languages, one whose package is 73 MB, and two that
         drag in a Newtonsoft.Json with a known high-severity advisory. -->
    <PackageVersion Include="LanguageDetection.Ai" Version="1.1.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- The companion's voice (voice engine design, 2026-09-18). sherpa-onnx (Apache-2.0) runs the
         Kokoro text-to-speech model in process on the CPU, through onnxruntime; the managed
         package pulls in one native package per platform and a published folder carries only
         its own. Its native library also carries espeak-ng (GPL-3.0-or-later), which turns words
         into sounds: fine beside Modbot's AGPL-3.0, and recorded in THIRD-PARTY-NOTICES.md. -->
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <!-- Windows sound output: WASAPI through NAudio (MIT). Only the Wasapi package, which brings
         Core; nothing that can record. -->
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Linux sound output: OpenAL Soft (LGPL-2.0-or-later, loaded as a shared library) through
         the Silk.NET binding (MIT). -->
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Extensions.Enumeration" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <!-- The voice is published as one .tar.bz2; .NET reads tar itself and this (MIT) reads bzip2. -->
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.1.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- A nightly, and the only prerelease pinned here. It is the regeneration against API
         specification v1.21.0's response shapes: Get User now answers with UserResponse and Get
         Current User with CurrentUserLoginResponse, neither of which 2.21.0 had. Both are wide
         union models that carry properties for fields the call they belong to does not send (the
         avatar pictures on UserResponse, for one), so the compiler no longer holds the line that
         the 2.21.0 models held. Modbot reads from each call only the fields that call is
         known to carry (research: vrchat-public-profile-findings.md §3), and that list, not the
         model, is what keeps a stale property from wiping a stored column.

         Moved from nightly.39 to nightly.41 on 2026-09-23. The two builds are the same code:
         their public members are identical, and the whole difference upstream is the version
         string the SDK reports about itself. It is here to keep the pin on the newest build
         rather than because anything was fixed. In particular requiresTwoFactorAuth is still a
         closed three-value enum, so a fourth two-factor method from VRChat would fail to
         deserialise the whole sign-in response; that one wants fixing upstream. -->
    <PackageVersion Include="VRChat.API" Version="2.21.1-nightly.41" />
    <!-- The official MCP SDK (MCP server design, 2026-09-17): the Streamable HTTP host for
         Modbot.Api, and the client half for the tests that talk to it. Stable since 2.0.0. -->
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />
  </ItemGroup>
  <!-- Test-only packages. -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>
</Project>