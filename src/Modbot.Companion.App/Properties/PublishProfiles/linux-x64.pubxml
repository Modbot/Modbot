<?xml version="1.0" encoding="utf-8"?>
<!--
  The Linux build, the twin of win-x64.pubxml:

      dotnet publish src/Modbot.Companion.App -c Release -p:PublishProfile=linux-x64 -p:ModbotRelease=2026.9.1

  The output folder is what `vpk [linux] pack` turns into the AppImage (see
  .github/workflows/companion-release.yml and docs/content/docs/companion/install.mdx). The
  choices below are the Windows profile's, for the reasons given there: self-contained so nobody
  installs .NET first, a folder rather than one self-extracting file, no trimming because Avalonia
  and the overlay reach types by reflection, and compiled ahead of time so start-up is not spent
  in the JIT. Velopack then wraps the folder as an AppImage, which is one file to download and
  run and needs nothing installed either.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/client/publish-linux/</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
