<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Modbot.Companion\Modbot.Companion.csproj" />
    <ProjectReference Include="..\Modbot.Overlay\Modbot.Overlay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Installer hooks and the update check. Used from Updates.cs and nowhere else; the source
         guard holds that. -->
    <PackageReference Include="Velopack" />
    <!-- The voice: text to speech in this process (Voice/SherpaVoice.cs), sound out on Windows
         (Voice/WindowsVoiceOutput.cs) and on Linux (Voice/OpenAlVoiceOutput.cs). Nothing here
         can record; the source guard holds that. -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Enumeration" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
    <!-- Keeping the last few minutes of VRChat's window, in ScreenRecording.cs and nowhere else:
         the desktop's own picture from DXGI, cut down to where Windows says VRChat is drawn, and
         Windows' own H.264 encoder from Media Foundation. The source guard holds that one file to
         it, and to being the only file that asks Windows about VRChat's window at all. Neither
         package ships a native library; both call what Windows already has, and on Linux nothing
         here is ever reached — there is no encoder a client that may not start a process can get
         at, which is the whole of why recording is Windows only (clips design spec 3.6). -->
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Vortice.MediaFoundation" />
  </ItemGroup>

  <!-- Where an installed client looks for newer versions of itself. Modbot Cloud by default: it
       serves the same release index the workflow publishes to GitHub, out of one cached copy, so
       however many clients exist GitHub is asked a few times a day rather than by each of them.
       The packages themselves are still downloaded from GitHub, because the index Cloud serves
       points at them.

       A fork or a mirror passes its own address
       (-p:ModbotUpdateFeed=https://github.com/owner/repo, or its own static host); the release
       workflow passes whichever address the release it is publishing should be checked at, so the
       client and the workflow cannot disagree. Read at run time by Updates.cs from the assembly's
       metadata. -->
  <PropertyGroup>
    <ModbotUpdateFeed Condition="'$(ModbotUpdateFeed)' == ''">https://cloud.modbot.co/api/v1/updates/companion</ModbotUpdateFeed>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ModbotUpdateFeed" Value="$(ModbotUpdateFeed)" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Windows and Linux are the release targets (M3 10); Quest and other standalone headsets
         cannot expose logs or host a SteamVR overlay at all, and there is no macOS build. The
         same code builds for both: the tray, the start-with-Windows switch and the modbot://
         link handler are Windows things and each is guarded, the device tokens have a key-file
         store where there is no DPAPI, VRChat's log is found under Proton (VRChatLogFolders),
         and the overlay hands SteamVR raw pixels where there is no Direct3D. A plain net10.0
         target rather than net10.0-windows so one project publishes both
         (Properties/PublishProfiles). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>WinExe</OutputType>
    <!-- Never a single-file publish. .NET's single-file mode extracts to a temp directory and
         runs from there, which is precisely the dropper pattern antivirus engines score on, and
         this client already looks enough like one. A normal folder layout, packaged by Velopack
         into a per-user installer; the publish settings live in
         Properties/PublishProfiles/win-x64.pubxml, which is the only way the client is built for
         other people's machines. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Stable across versions, so download reputation accumulates on one identity rather than
         being spread across many. -->
    <AssemblyName>Modbot</AssemblyName>
    <RootNamespace>Modbot.Companion.App</RootNamespace>
    <!-- The head-only mascot mark, as every Modbot surface shows it (.agent/specs/2026-09-16-brand-design.md). -->
    <ApplicationIcon>Assets\Modbot.ico</ApplicationIcon>
    <!-- OpenAL names devices through raw pointers. Confined to Voice/OpenAlVoiceOutput.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The same mark for the window and the tray, and the wordmark's face: a static cut of
         Bricolage Grotesque (OFL, see THIRD-PARTY-NOTICES.md), read from the assembly so nothing
         depends on the fonts a machine has installed. -->
    <AvaloniaResource Include="Assets\Modbot.ico" />
    <AvaloniaResource Include="Assets\icon-256.png" />
    <AvaloniaResource Include="Assets\Fonts\BricolageGrotesque-Wordmark.ttf" />
  </ItemGroup>

  <!-- The overlay project ships OpenVR for both platforms, so a plain build and the tests have
       both beside them. A published folder is for one kind of machine, and the other platform's
       library stays out of it. -->
  <Target Name="LeaveOutTheOtherPlatformsOpenVr" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$(RuntimeIdentifier.StartsWith('linux')) And '%(ResolvedFileToPublish.RelativePath)' == 'openvr_api.dll'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$(RuntimeIdentifier.StartsWith('win')) And '%(ResolvedFileToPublish.RelativePath)' == 'libopenvr_api.so'" />
      <!-- Windows speaks through WASAPI, so OpenAL Soft's Windows build is never loaded there. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$(RuntimeIdentifier.StartsWith('win')) And '%(ResolvedFileToPublish.RelativePath)' == 'soft_oal.dll'" />
    </ItemGroup>
  </Target>

</Project>
