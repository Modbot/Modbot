<?xml version="1.0" encoding="utf-8"?>
<!--
  The one way the client is built for other people's machines:

      dotnet publish src/Modbot.Client.App -c Release -p:PublishProfile=win-x64 -p:ModbotRelease=2026.9.1

  The output folder is what `vpk pack` turns into the installer (see .github/workflows/client-release.yml
  and docs/content/docs/desktop-client/install.mdx).
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\client\publish\</PublishDir>

    <!-- Self-contained: a tester installs Modbot and nothing else. Asking a volunteer to install
         the .NET runtime first is a step many will not take, and a "you need .NET 10" dialog from
         an installer is exactly the experience this profile exists to remove. -->
    <SelfContained>true</SelfContained>

    <!-- A folder of files, never one self-extracting exe. .NET's single-file mode unpacks native
         libraries to a temp folder and runs from there, which is the behaviour antivirus engines
         score as a dropper (M3 8.3), and this client already looks enough like one. The overlay's
         openvr_api.dll and Avalonia's Skia libraries also want to be ordinary files beside the
         exe. -->
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Trimming is off: Avalonia and the overlay's Direct3D binding reach types by reflection,
         and a trimmed build fails at run time in whichever corner the trimmer could not see. -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Compiled ahead of time so a tray app that starts with Windows is not spending its first
         seconds in the JIT. Larger on disk; that is the trade. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
</Project>
