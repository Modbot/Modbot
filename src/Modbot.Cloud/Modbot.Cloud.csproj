<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Web/ is the npm project that builds wwwroot. Without this the Web SDK globs its
         node_modules into the build as content, which is slow and would publish them. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Web\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared logging: CONSOLE_LOG_MODE, LOG_LEVEL and the three console shapes. -->
    <ProjectReference Include="..\Modbot.Shared\Modbot.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Serilog.AspNetCore" />
    <!-- Compile assets are needed: the two design-time factories implement
         IDesignTimeDbContextFactory. PrivateAssets keeps it out of the published app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Modbot.Cloud.Tests" />
  </ItemGroup>

</Project>
