{
  "controller_type": "holographic_controller",
  "name": "Modbot default for Windows Mixed Reality controllers",
  "description": "The grip is a switch, so the grip button is the grab.",
  "bindings": {
    "/actions/modbot": {
      "poses": [
        { "output": "/actions/modbot/in/aim", "path": "/user/hand/left/pose/tip" },
        { "output": "/actions/modbot/in/aim", "path": "/user/hand/right/pose/tip" },
        { "output": "/actions/modbot/in/hand", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/modbot/in/hand", "path": "/user/hand/right/pose/raw" }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/grip" } }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/grip" } }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/click" } }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/click" } }
        },
        {
          "path": "/user/hand/left/input/joystick",
          "mode": "joystick",
          "inputs": { "position": { "output": "/actions/modbot/in/scroll" } }
        },
        {
          "path": "/user/hand/right/input/joystick",
          "mode": "joystick",
          "inputs": { "position": { "output": "/actions/modbot/in/scroll" } }
        }
      ]
    }
  }
}
