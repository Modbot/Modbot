{
  "controller_type": "knuckles",
  "name": "Modbot default for Valve Index controllers",
  "description": "Grab is how hard the grip is squeezed (its force sensor), as XSOverlay reads it.",
  "bindings": {
    "/actions/modbot": {
      "poses": [
        { "output": "/actions/modbot/in/aim", "path": "/user/hand/left/pose/tip" },
        { "output": "/actions/modbot/in/aim", "path": "/user/hand/right/pose/tip" },
        { "output": "/actions/modbot/in/hand", "path": "/user/hand/left/pose/raw" },
        { "output": "/actions/modbot/in/hand", "path": "/user/hand/right/pose/raw" }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "force_sensor",
          "inputs": { "force": { "output": "/actions/modbot/in/grab" } }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "force_sensor",
          "inputs": { "force": { "output": "/actions/modbot/in/grab" } }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/click" } }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": { "click": { "output": "/actions/modbot/in/click" } }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": { "position": { "output": "/actions/modbot/in/scroll" } }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": { "position": { "output": "/actions/modbot/in/scroll" } }
        }
      ]
    }
  }
}
