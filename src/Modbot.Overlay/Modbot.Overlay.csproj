<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Modbot.Companion\Modbot.Companion.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Vortice.Direct3D11" />
    <PackageReference Include="Silk.NET.OpenXR" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" />
    <PackageReference Include="Silk.NET.Vulkan" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- Valve's OpenVR runtime library, copied beside the exe. OpenVrInterop loads "openvr_api"
         by name, and the pinned IVROverlay_028 function table it calls through is only right
         against a dll that speaks that version, so the dll is vendored here, at a known version,
         rather than picked up from whatever SteamVR happens to be installed. It is Valve's own
         win64 build from the openvr repository at v2.15.6 (SHA-256
         bab8ac6ef64e68a9ca53315b0014d131088584b2efdfa6db511d67ec03cfcb4a), redistributed under its
         BSD 3-clause licence; the licence file travels with it and THIRD-PARTY-NOTICES.md at the
         repository root records the attribution. Each build is a harmless extra file on the
         other platform. -->
    <None Include="native\win-x64\openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native\win-x64\openvr_api.LICENSE.txt" Link="openvr_api.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The same library, Valve's own linux64 build from the same tag (SHA-256
         cb68c5788b0ddab32c0402e58820956a489ef6cb99ecf2e1fa997533ead54475), for a companion run on
         Linux: .NET looks for "libopenvr_api.so" there when the code asks for "openvr_api". -->
    <None Include="native\linux-x64\libopenvr_api.so" Link="libopenvr_api.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The OpenVR function table is an ordered array of function pointers, and the OpenXR and
         Vulkan bindings are pointer-shaped throughout; calling either needs unsafe code. It is
         confined to OpenVr/ and OpenXr/. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
