<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Modbot.Api\Modbot.Api.csproj" />
    <ProjectReference Include="..\Modbot.Demo\Modbot.Demo.csproj" />
    <ProjectReference Include="..\Modbot.Discord\Modbot.Discord.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The OpenAPI document, written at build time to docs/openapi/modbot.json for the documentation
    site. It is committed, so the docs build needs no .NET, and CI fails when a build changes it
    (the committed copy is out of date).

    The build starts Program.cs with a server that listens on nothing; Program.cs recognises that
    run (BuildTimeDocument) and skips the database and the background services.

    Off in Docker and wherever ModbotOpenApiDocument=false is passed: the image has no docs folder
    to write into, and a container build has no use for the file.
  -->
  <PropertyGroup>
    <OpenApiGenerateDocuments Condition="'$(ModbotOpenApiDocument)' == 'false' or '$(DOTNET_RUNNING_IN_CONTAINER)' == 'true'">false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)..\..\docs\openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name modbot</OpenApiGenerateDocumentsOptions>
  
    <!-- The web SDK turns Server GC on by default, which keeps a heap per core and lets each one
         grow before collecting. That is the right trade for a machine whose job is throughput, and
         the wrong one here: this is the server people run on their own hardware, sometimes a
         Raspberry Pi, and it spends its life waiting. On timers, on Discord's socket, and on
         VRChat at 1.45 requests a second. Measured at idle against a real database, same binary,
         only this flag differing: 215 MB private and 62 threads with it on, 70 MB and 27 threads
         with it off.

         Background GC stays on. Turning that off as well was measured too, and cost 37 MB rather
         than saving any, because gen2 collections become blocking and the heap is allowed to grow
         further between them. GCConserveMemory came out inside the noise.

         Only this project. Cloud, My and Landing are served from machines we run ourselves, where
         answering many callers at once is worth more than the megabytes. An operator running this
         one on a large machine can put Server GC back with the DOTNET_gcServer variable.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    The git commit and branch this build was made from, stamped into the assembly as metadata and
    read back by BuildSource for the Deployment card.

    First answer wins: the ModbotCommit / ModbotBranch properties (`-p:ModbotCommit=...`), then
    Railway's build variables (the Dockerfile declares them as build arguments, which makes them
    environment variables, which MSBuild reads as properties), then GitHub Actions', then git
    itself. git is only asked when a .git exists here, and a failure is ignored: the Docker build
    context has no .git, and a machine without git must still build. Nothing found means nothing is
    stamped, and BuildSource falls back to the same variables at runtime.

    Stamped here and not in Modbot.Shared, because nothing references Modbot.Server. A value in a
    shared assembly would change with every commit and rebuild every project that depends on it.
  -->
  <Target Name="StampModbotBuildSource" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <ModbotCommit Condition="'$(ModbotCommit)' == ''">$(RAILWAY_GIT_COMMIT_SHA)</ModbotCommit>
      <ModbotCommit Condition="'$(ModbotCommit)' == ''">$(GITHUB_SHA)</ModbotCommit>
      <ModbotBranch Condition="'$(ModbotBranch)' == ''">$(RAILWAY_GIT_BRANCH)</ModbotBranch>
      <!-- On a pull request GITHUB_REF_NAME is "123/merge"; on a tag push it is the tag. -->
      <ModbotBranch Condition="'$(ModbotBranch)' == ''">$(GITHUB_HEAD_REF)</ModbotBranch>
      <ModbotBranch Condition="'$(ModbotBranch)' == '' and '$(GITHUB_REF_TYPE)' == 'branch'">$(GITHUB_REF_NAME)</ModbotBranch>
      <_ModbotAskGit>false</_ModbotAskGit>
      <_ModbotAskGit Condition="('$(ModbotCommit)' == '' or '$(ModbotBranch)' == '') and Exists('$(MSBuildThisFileDirectory)..\..\.git')">true</_ModbotAskGit>
    </PropertyGroup>

    <Exec Condition="'$(_ModbotAskGit)' == 'true' and '$(ModbotCommit)' == ''"
          Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ModbotGitCommit" />
      <Output TaskParameter="ExitCode" PropertyName="_ModbotGitCommitExit" />
    </Exec>

    <Exec Condition="'$(_ModbotAskGit)' == 'true' and '$(ModbotBranch)' == ''"
          Command="git rev-parse --abbrev-ref HEAD" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" ContinueOnError="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_ModbotGitBranch" />
      <Output TaskParameter="ExitCode" PropertyName="_ModbotGitBranchExit" />
    </Exec>

    <PropertyGroup>
      <ModbotCommit Condition="'$(ModbotCommit)' == '' and '$(_ModbotGitCommitExit)' == '0'">$(_ModbotGitCommit.Trim())</ModbotCommit>
      <!-- A detached checkout answers "HEAD", which is not a branch. -->
      <ModbotBranch Condition="'$(ModbotBranch)' == '' and '$(_ModbotGitBranchExit)' == '0' and '$(_ModbotGitBranch.Trim())' != 'HEAD'">$(_ModbotGitBranch.Trim())</ModbotBranch>
    </PropertyGroup>

    <ItemGroup>
      <AssemblyMetadata Include="ModbotCommit" Value="$(ModbotCommit)" Condition="'$(ModbotCommit)' != ''" />
      <AssemblyMetadata Include="ModbotBranch" Value="$(ModbotBranch)" Condition="'$(ModbotBranch)' != ''" />
    </ItemGroup>
  </Target>

</Project>
