<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Modbot.Core\Modbot.Core.csproj" />
    <!-- The sync producers write facts, and the fact log is Modbot.Analytics'. The dependency
         runs this way round rather than the other because the analytics foundation must not know
         where its facts came from: VRChat, Discord and the Windows client are all just callers of
         IFactWriter, and a reference back would make the log's schema hostage to one of them. -->
    <ProjectReference Include="..\Modbot.Analytics\Modbot.Analytics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="VRChat.API" />
  </ItemGroup>

  <ItemGroup>
    <!-- The priority gate is an implementation detail of the limiter, and also the one piece of
         it whose ordering can only be observed deterministically from the inside: from outside,
         "which queued call went first" is a race the test would have to sleep on. -->
    <InternalsVisibleTo Include="Modbot.VRChat.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
