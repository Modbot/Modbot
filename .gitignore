# ---- Modbot workspace exclusions ----
# Reference-only clones. Not part of the Modbot source tree.
libs/
old/

# ---- .NET ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.user
*.suo
*.userprefs
.vs/
artifacts/
TestResults/
*.binlog
BenchmarkDotNet.Artifacts/

# ---- Node / frontend ----
node_modules/
dist/
/build/
.next/
.turbo/
.vite/
*.tsbuildinfo
.pnpm-store/

# ---- Secrets & local config ----
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
*.pfx
*.key
secrets.json

# ---- Local data ----
*.db
*.db-shm
*.db-wal
# Anchored: an unanchored `data/` also matches src/Modbot.Core/Data and tests/.../Data,
# which silently swallowed the entire EF Core model.
/data/
logs/
*.log

# ---- Editors / OS ----
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Agent scratch ----
# NOTE: .agent/ is TRACKED (specs, plans, research). Only .remember/ is local.
.remember/

output_log_*.txt

# explore scratch output
explore/responses/
explore/logs/

.session.json

# Raw API responses contain real user data -- curate fixtures deliberately instead
explore/responses/

# .NET build output
[Bb]in/
[Oo]bj/
logs/

# Node
node_modules/
src/Modbot.Host/wwwroot/
# Built by src/Modbot.My.Web.
src/Modbot.My/wwwroot/
# Built by src/Modbot.Landing/Web.
src/Modbot.Landing/wwwroot/
# Built by src/Modbot.Cloud/Web.
src/Modbot.Cloud/wwwroot/
# The docs site's build output and the files Next.js and Fumadocs generate.
docs/out/
docs/.source/
docs/next-env.d.ts

# Local scratch: live-data pulls, transcripts, anything that must never be committed.
/.local/

# Agent worktrees created by Claude Code (each is its own checkout; never part of the product)
/.claude/worktrees/
